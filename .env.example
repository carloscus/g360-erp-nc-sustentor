# Variables de entorno del proyecto.
# Generado por `g360 agents`: completá cada valor con su default real.
# La app debe arrancar con estos defaults o fallar con un error claro.

G360_DATA_DIR=%APPDATA%\g360-erp-nc-sustentor\data
G360_DB_ORIGEN=
G360_LOG_DIR=%APPDATA%\g360-erp-nc-sustentor\logs
G360_LOG_LEVEL=INFO
G360_PORTABLE_DIR=
# Vista de la app, solo aplica al modo escritorio. Valores de flet.AppView
# (FLET_APP, FLET_APP_WEB, WEB_BROWSER). Vacio = default por entorno:
# FLET_APP si esta congelado (.exe) y WEB_BROWSER en desarrollo.
# ADVERTENCIA: forzar WEB_BROWSER en un .exe congelado deja la app SIN VENTANA
# (el binario no trae un navegador propio); usar FLET_APP en el ejecutable.
G360_VIEW=
